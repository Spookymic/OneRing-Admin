# OneRing Admin — reverse proxy HTTPS (interne)
# Le domaine est injecté via la variable d'environnement APP_DOMAIN (docker-compose.yml).
# Voir docs/Deploiement-domaine.md

# Fallback "localhost" si APP_DOMAIN n'est pas defini (evite un Caddyfile invalide).
# Definir APP_DOMAIN dans .env pour servir le vrai domaine. Voir docs/Deploiement-domaine.md
{$APP_DOMAIN:localhost} {
	# Certificat signé par la CA interne de Caddy (réseau interne / LAN).
	# Pour des certificats publiquement reconnus, voir docs/Deploiement-domaine.md (DNS-01).
	tls internal

	# Relaie vers le conteneur Next.js sur le réseau Docker interne.
	reverse_proxy app:3000

	encode gzip

	# HSTS — force HTTPS côté navigateur.
	# ⚠️ NE PAS activer avec `tls internal` (certificat auto-signé) : HSTS rend
	# l'avertissement de certificat NON contournable et bloquerait l'accès.
	# À décommenter uniquement avec un certificat publiquement reconnu (DNS-01,
	# voir docs/Deploiement-domaine.md).
	# header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Masque la bannière serveur.
	header -Server
}
