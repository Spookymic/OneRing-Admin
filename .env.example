# Azure AD / Microsoft Entra
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_TENANT_ID=your-tenant-id

# Domaine et NextAuth
# APP_DOMAIN : nom de domaine servi par Caddy en HTTPS (voir docs/Deploiement-domaine.md)
# NEXTAUTH_URL doit correspondre exactement (https://<APP_DOMAIN>).
APP_DOMAIN=onering.example.local
NEXTAUTH_URL=https://onering.example.local
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Developpement local (npm run dev, hors Docker) : NEXTAUTH_URL=http://localhost:3000

# Cle de chiffrement des secrets TOTP (2FA admin local) au repos.
# Optionnel : si absent, NEXTAUTH_SECRET est utilise. Recommande : cle dediee.
# TOTP_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# PostgreSQL — utiliser un mot de passe fort et unique (pas de valeur triviale)
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://m365admin:change-me-strong-password@localhost:5432/m365admin

# Exchange Online bridge (sidecar PowerShell app-only) — voir exo-bridge/README.md
# Deposer le .pfx dans exo-bridge/secrets/onering-exo.pfx
EXO_APP_ID=your-exo-app-client-id
EXO_ORG=yourtenant.onmicrosoft.com
EXO_CERT_PASSWORD=your-pfx-password
EXO_BRIDGE_SECRET=generate-with-openssl-rand-base64-32
